# FastAPI backend port (local dev)
PORT=8000

# Enable background download scheduler
# Without this, only the web server runs; no media is downloaded.
# ENABLE_SCHEDULER=true

# Enable HTTP access logs (disabled by default)
# ENABLE_ACCESS_LOG=true

# Storage path (defaults are for Docker; uncomment and set for local dev)
# STORAGE_BASE=~/path/to/amstramgram

# Telegram notifications on critical scheduler failure (optional)
# TELEGRAM_BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff
# TELEGRAM_CHAT_ID=-1001234567890

# --- Scheduler tuning (all values in seconds unless noted) ---
# Accounts checked per cycle (random pick in [MIN, MAX])
# SYNC_ACCOUNTS_PER_CYCLE_MIN=5
# SYNC_ACCOUNTS_PER_CYCLE_MAX=10

# Max posts fetched per not-yet-backfilled account (keeps feed fresh)
# SYNC_MAX_RECENT_POSTS=5

# Posts downloaded per account during historical backfill (random in [MIN, MAX])
# SYNC_BACKFILL_MIN=30
# SYNC_BACKFILL_MAX=60

# Delay between individual post downloads within an account
# SYNC_POST_DELAY_MIN=10
# SYNC_POST_DELAY_MAX=30

# Delay between consecutive accounts within a group
# SYNC_ACCOUNT_DELAY_MIN=60
# SYNC_ACCOUNT_DELAY_MAX=180

# Delay between groups of accounts
# SYNC_GROUP_DELAY_MIN=600
# SYNC_GROUP_DELAY_MAX=1200

# Delay between accounts during historical backfill
# SYNC_BACKFILL_DELAY_MIN=180
# SYNC_BACKFILL_DELAY_MAX=360

# Delay between full sync cycles after a successful run (default: 12–24 h)
# SYNC_CYCLE_DELAY_MIN=43200
# SYNC_CYCLE_DELAY_MAX=86400

# Delay before the first cycle after startup (default: 5–30 min)
# SYNC_INITIAL_DELAY_MIN=300
# SYNC_INITIAL_DELAY_MAX=1800

# Rate-limit handling
# SYNC_RATE_LIMIT_RETRIES=2
# SYNC_RATE_LIMIT_BACKOFF_BASE=1800
# SYNC_RATE_LIMIT_BACKOFF_MAX=10800
